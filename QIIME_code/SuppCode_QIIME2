qiime feature-table summarize --i-table filtered-table-no-ctrls-food-blank-MEC-AX-CV-INOC-PR-grouped-TreatmentDay.qza  --o-visualization filtered-table-no-ctrls-food-blank-MEC-AX-CV-INOC-PR-grouped-TreatmentDay.qzv --m-sample-metadata-file sample-metadata-collapsed-TreatmentDay.txt

#Generate taxa barplot
qiime taxa barplot --i-table filtered-table-no-ctrls-food-blank-MEC-AX-CV-INOC-PR-grouped-TreatmentDay.qza --i-taxonomy taxonomy.qza --m-metadata-file sample-metadata-collapsed-TreatmentDay.txt --o-visualization taxa-barplot-filtered-table-no-ctrls-food-blank-MEC-AX-CV-INOC-PR-grouped-TreatmentDay.qzv

#FILTER SAMPLES TO INOC AND CV-1-2 features only
qiime feature-table filter-samples --i-table filtered-table-no-ctrls-food-blank-MEC-AX-CV-INOC-PR.qza --m-metadata-file sample-metadata.txt --p-where 'TreatmentDay = "INOC" OR TreatmentDay = "CV-1-2"' --o-filtered-table filtered-table-no-ctrls-food-blank-CV-1-2-INOC.qza

#Visualize filtered table
qiime feature-table summarize --i-table filtered-table-no-ctrls-food-blank-CV-1-2-INOC.qza --o-visualization filtered-table-no-ctrls-food-blank-CV-1-2-INOC.qzv --m-sample-metadata-file sample-metadata.txt

#Transpose feature table
qiime feature-table transpose --i-table filtered-table-no-ctrls-food-blank-CV-1-2-INOC.qza --o-transposed-feature-table filtered-table-no-ctrls-food-blank-CV-1-2-INOC-transposed.qza

#ADD TAXONOMY TO FEATURE TABLE
qiime metadata tabulate --m-input-file filtered-table-no-ctrls-food-blank-CV-1-2-INOC-transposed.qza --m-input-file taxonomy.qza  --o-visualization filtered-table-no-ctrls-food-blank-CV-1-2-INOC-transposed-with-taxonomy.qzv

